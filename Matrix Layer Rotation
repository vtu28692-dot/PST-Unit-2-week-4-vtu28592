import java.io.*;
import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int numLayers = Math.min(m, n) / 2;

        for (int layer = 0; layer < numLayers; layer++) {
            List<Integer> layerElements = new ArrayList<>();

            // 1. Extract elements in counter-clockwise order
            // Top row
            for (int j = layer; j < n - layer; j++) {
                layerElements.add(matrix.get(layer).get(j));
            }
            // Right column
            for (int i = layer + 1; i < m - layer - 1; i++) {
                layerElements.add(matrix.get(i).get(n - 1 - layer));
            }
            // Bottom row
            for (int j = n - 1 - layer; j >= layer; j--) {
                layerElements.add(matrix.get(m - 1 - layer).get(j));
            }
            // Left column
            for (int i = m - 2 - layer; i > layer; i--) {
                layerElements.add(matrix.get(i).get(layer));
            }

            // 2. Rotate elements counter-clockwise by effective shift
            int len = layerElements.size();
            int shift = r % len;
            List<Integer> rotated = new ArrayList<>(len);
            for (int i = 0; i < len; i++) {
                rotated.add(layerElements.get((i + shift) % len));
            }

            // 3. Place rotated elements back into matrix
            int idx = 0;
            // Top row
            for (int j = layer; j < n - layer; j++) {
                matrix.get(layer).set(j, rotated.get(idx++));
            }
            // Right column
            for (int i = layer + 1; i < m - layer - 1; i++) {
                matrix.get(i).set(n - 1 - layer, rotated.get(idx++));
            }
            // Bottom row
            for (int j = n - 1 - layer; j >= layer; j--) {
                matrix.get(m - 1 - layer).set(j, rotated.get(idx++));
            }
            // Left column
            for (int i = m - 2 - layer; i > layer; i--) {
                matrix.get(i).set(layer, rotated.get(idx++));
            }
        }

        // Print final rotated matrix
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(matrix.get(i).get(j)).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb);
    }

    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        for (int i = 0; i < m; i++) {
            String[] matrixRowItems = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
            List<Integer> matrixRow = new ArrayList<>();

            for (int j = 0; j < n; j++) {
                int matrixItem = Integer.parseInt(matrixRowItems[j]);
                matrixRow.add(matrixItem);
            }

            matrix.add(matrixRow);
        }

        matrixRotation(matrix, r);
        bufferedReader.close();
    }
}
